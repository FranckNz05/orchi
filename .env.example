# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Base de donnees ---------------------------------------------------------
# SQLite en dev. En prod : postgresql://user:pass@host:5432/orchi
DATABASE_URL="file:./dev.db"

# --- Coffre de cles ----------------------------------------------------------
# Chiffrement AES-256-GCM des credentials agregateurs des marchands.
# 32 octets en base64. Generer : openssl rand -base64 32
ENCRYPTION_KEY=

# Sel du hachage des cles API (HMAC-SHA256). openssl rand -base64 32
API_KEY_PEPPER=

# --- URL publique -----------------------------------------------------------
# Telle que les agregateurs doivent joindre l'orchestrateur. Sert a construire
# les URL de callback : une valeur fausse rend toute notification impossible.
PUBLIC_BASE_URL=http://localhost:3000

# --- Console d'exploitation --------------------------------------------------
# Refusee par defaut en production : elle invite a coller une cle API secrete
# dans un navigateur. Acceptable en local, pas au-dela.
CONSOLE_ENABLED=false

# --- Workers ----------------------------------------------------------------
WORKERS_ENABLED=true
SWEEPER_INTERVAL_MS=60000
SWEEPER_MIN_AGE_MS=45000
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# --- Agregateurs ------------------------------------------------------------
# Adaptateurs actives. Par defaut le simulateur seul : FedaPay et CinetPay sont
# ecrits d'apres la doc publique et doivent etre valides en sandbox avant d'etre
# ajoutes ici. Exemple : sandbox,fedapay,cinetpay
PROVIDERS_ENABLED=sandbox

# Surcharges d'hote (tests de contrat, proxy). Laisser vide en production.
# FEDAPAY_BASE_URL=
# CINETPAY_CHECKOUT_URL=
# CINETPAY_TRANSFER_URL=

# --- Tarification Orchi ------------------------------------------------------
# Taux TOTAL supporte par le marchand, en points de base (500 = 5,00 %).
# La part Orchi est le solde apres la commission de l'agregateur : si celui-ci
# prend 2 %, Orchi prend 3 %. Le marchand paie donc le meme taux quel que soit
# l'agregateur retenu par le routage.
PLATFORM_TOTAL_PAYIN_BPS=500
PLATFORM_TOTAL_PAYOUT_BPS=500

# Comment la part Orchi est reellement percue : split | on_top | invoice.
# Ne change pas le calcul, seulement le mode d'encaissement.
PLATFORM_FEE_COLLECTION=split

# --- Divers ------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
