# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Base de donnees ---------------------------------------------------------
# SQLite en dev. En prod : postgresql://user:pass@host:5432/orchi
DATABASE_URL="file:./dev.db"

# --- Coffre de cles ----------------------------------------------------------
# Chiffrement AES-256-GCM des credentials agregateurs des marchands.
# 32 octets en base64. Generer : openssl rand -base64 32
ENCRYPTION_KEY=

# Sel du hachage des cles API (HMAC-SHA256). openssl rand -base64 32
API_KEY_PEPPER=

# --- URL publique -----------------------------------------------------------
# Telle que les agregateurs doivent joindre l'orchestrateur. Sert a construire
# les URL de callback : une valeur fausse rend toute notification impossible.
PUBLIC_BASE_URL=http://localhost:3000

# --- Console d'exploitation --------------------------------------------------
# Refusee par defaut en production : elle invite a coller une cle API secrete
# dans un navigateur. Acceptable en local, pas au-dela.
CONSOLE_ENABLED=false

# --- Workers ----------------------------------------------------------------
WORKERS_ENABLED=true
SWEEPER_INTERVAL_MS=60000
SWEEPER_MIN_AGE_MS=45000
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# --- Agregateurs ------------------------------------------------------------
# Adaptateurs actives. Par defaut le simulateur seul : FedaPay et CinetPay sont
# ecrits d'apres la doc publique et doivent etre valides en sandbox avant d'etre
# ajoutes ici. Exemple : sandbox,fedapay,cinetpay
PROVIDERS_ENABLED=sandbox

# Surcharges d'hote (tests de contrat, proxy). Laisser vide en production.
# FEDAPAY_BASE_URL=
# CINETPAY_CHECKOUT_URL=
# CINETPAY_TRANSFER_URL=

# --- Tarification Orchi ------------------------------------------------------
# Taux TOTAL supporte par le marchand, en points de base (500 = 5,00 %).
# La part Orchi est le solde apres la commission de l'agregateur : si celui-ci
# prend 2 %, Orchi prend 3 %. Le marchand paie donc le meme taux quel que soit
# l'agregateur retenu par le routage.
PLATFORM_TOTAL_PAYIN_BPS=500
PLATFORM_TOTAL_PAYOUT_BPS=500

# Comment la part Orchi est reellement percue : invoice | split | on_top.
# Ne change pas le calcul, seulement les ecritures du grand livre.
#
#   invoice  la part est constatee en creance sur merchant:{id}:billing, et
#            facturee ensuite. Seul mode compatible avec le modele A, ou Orchi
#            ne detient pas les fonds et ne peut donc rien retenir dessus.
#   split    l'agregateur reverse directement la part Orchi, qui est alors
#            reellement retenue sur le flux. Exige un accord sub-merchant, a
#            n'activer que la ou cet accord existe.
#   on_top   non implemente : le serveur refuse de demarrer. Majorer le montant
#            demande au client final touche a la creation de paiement et a
#            chaque adaptateur, pas au grand livre.
PLATFORM_FEE_COLLECTION=invoice

# --- Repartition aux partenaires ---------------------------------------------
# Delai avant qu'une part partenaire ne devienne reglable, en millisecondes.
# Un encaissement reussi ne veut pas dire fonds disponibles : les agregateurs
# reglent souvent a J+1. Verser avant, c'est verser ce qui n'est pas arrive.
PARTNER_SETTLEMENT_DELAY_MS=86400000

# Montant minimal d'un versement groupe, en unites mineures. En dessous, le
# versement est REPORTE et les accumulations grossissent — jamais annule.
PARTNER_SETTLEMENT_MIN_MINOR=1000

# --- Limites anti-force-brute ------------------------------------------------
# Le quota global ci-dessous est dimensionne pour du trafic de paiement : il
# laisserait 300 essais de mot de passe par minute. Ces routes ont donc leurs
# propres limites, bien plus strictes. Elles portent sur l'IP, pas sur le compte
# vise : verrouiller un compte permettrait d'enfermer dehors son titulaire.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=5 minutes
REGISTER_RATE_LIMIT_MAX=20
REGISTER_RATE_LIMIT_WINDOW=1 hour

# --- Divers ------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
