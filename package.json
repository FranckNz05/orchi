{
  "name": "orchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orchestrateur de paiement pan-africain - API unifiee pay-in / payout",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed-catalog.ts && tsx scripts/seed.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:provider": "node scripts/set-db-provider.mjs",
    "render:build": "npm run db:provider && prisma generate && npm run build",
    "render:start": "npm run db:provider && prisma db push --skip-generate && node dist/scripts/seed-catalog.js && node dist/scripts/create-admin.js && node dist/scripts/seed-demo.js --auto && node dist/src/index.js",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
